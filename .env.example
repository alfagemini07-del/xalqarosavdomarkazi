# Supabase Dashboard -> Connect -> Session pooler (port 5432) URI
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Productionda uzun va tasodifiy qiymat ishlating. Render buni o'zi generatsiya qiladi.
SECRET_KEY=change-this-to-a-long-random-value

# Birinchi ishga tushishda yaratiladigan bosh texnik administrator
INITIAL_TECHADMIN_USERNAME=techadmin
INITIAL_TECHADMIN_PASSWORD=change-this-password

INITIAL_PRICE=30000
INITIAL_ENTRY_PRICE=30000
INITIAL_RELOAD_PRICE=30000
APP_TIMEZONE=Asia/Tashkent
COOKIE_SECURE=false
DB_POOL_SIZE=5
LOCAL_PRINTER_AGENT_ENABLED=true
SUPABASE_DB_LIMIT_BYTES=524288000
